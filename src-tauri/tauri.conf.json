{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GRISTbackup",
  "version": "0.2.5",
  "identifier": "com.aldric.GRISTbackup",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Outil de sauvegarde GRIST",
        "width": 1024,
        "height": 768,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
